{
  "type": "footer",
  "name": "t:names.footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "group_newsletter": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "background_media": "none",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "text_heading": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Join our mailing list</h2>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_body": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>Get exclusive deals and early access to new products.</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "email_signup": {
              "type": "email-signup",
              "name": "t:names.email_signup",
              "settings": {
                "width": "fill",
                "custom_width": 100,
                "heading": "",
                "border_style": "all",
                "input_style": "custom",
                "border_width": 2,
                "border_radius": 11,
                "input_background_color": "#14100F",
                "input_border_color": "#3A322D",
                "input_type_preset": "paragraph",
                "style_class": "button-secondary",
                "custom_button_background": "#F2B233",
                "custom_button_text": "#14100F",
                "custom_button_border": "#F2B233",
                "display_type": "text",
                "label": "Join",
                "integrated_button": false,
                "button_type_preset": "paragraph",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["text_heading", "text_body", "email_signup"]
        },
        "menu_shop": {
          "type": "menu",
          "settings": {
            "menu": "footer-shop",
            "heading": "Shop",
            "menu_spacing": 10,
            "show_as_accordion": false,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "menu_help": {
          "type": "menu",
          "settings": {
            "menu": "footer-help",
            "heading": "Help",
            "menu_spacing": 10,
            "show_as_accordion": false,
            "heading_preset": "paragraph",
            "link_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": ["group_newsletter", "menu_shop", "menu_help"],
      "name": "t:names.footer",
      "settings": {
        "section_width": "page-width",
        "gap": 40,
        "background_color": "#14100F",
        "padding-block-start": 52,
        "padding-block-end": 36
      }
    },
    "utilities": {
      "type": "footer-utilities",
      "blocks": {
        "copyright": {
          "type": "footer-copyright",
          "settings": {
            "show_powered_by": false,
            "font_size": "0.75rem",
            "case": "none"
          }
        },
        "policy_list": {
          "type": "footer-policy-list",
          "settings": {
            "font_size": "0.75rem",
            "case": "none"
          }
        }
      },
      "block_order": ["copyright", "policy_list"],
      "settings": {
        "section_width": "page-width",
        "gap": 24,
        "background_color": "#14100F",
        "divider_thickness": 1,
        "padding-block-start": 12,
        "padding-block-end": 16
      }
    }
