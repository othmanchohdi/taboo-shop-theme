{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "taboo_ticker": {
      "type": "header-ticker-taboo",
      "blocks": {
        "item_1": { "type": "item", "settings": { "text": "300 cards per pack" } },
        "item_2": { "type": "item", "settings": { "text": "No buzzer. No timer. No giant box." } },
        "item_3": { "type": "item", "settings": { "text": "Learn it in under 60 seconds" } },
        "item_4": { "type": "item", "settings": { "text": "Free shipping over $35" } }
      },
      "block_order": ["item_1", "item_2", "item_3", "item_4"],
      "settings": {
        "background_color": "#F2B233",
        "text_color": "#14100F",
        "speed": 26,
        "aria_label": "Store highlights"
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "type_font_primary_size": "0.875rem",
            "menu_font_style": "inverse",
            "type_font_primary_link": "accent",
            "type_case_primary_link": "none",
            "menu_style": "text",
            "navigation_bar": false,
            "drawer_accordion": false,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": false
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "left",
        "menu_row": "top",
        "show_search": false,
        "show_country": false,
        "show_language": false,
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 0,
        "border_width": 0,
        "background_color_top": "#14100F",
        "text_color_top": "#FFF6E9",
        "bubble_background_color": "#E8402A",
        "bubble_text_color": "#FFF6E9",
        "enable_transparent_header_home": false,
        "enable_transparent_header_product": false,
        "enable_transparent_header_collection": false
      }
    },
    "mobile_tab_bar": {
      "type": "mobile-tab-bar",
      "blocks": {
        "tab_home": {
          "type": "tab",
          "settings": {
            "label": "Home",
            "url": "/",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10.5 12 3l9 7.5\"></path><path d=\"M5.5 9.5V20h13V9.5\"></path><path d=\"M9.5 20v-5.5h5V20\"></path></svg>"
          }
        },
        "tab_shop": {
          "type": "tab",
          "settings": {
            "label": "Shop",
            "url": "/collections/all",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3.5\" y=\"4.5\" width=\"7\" height=\"7\" rx=\"1.5\"></rect><rect x=\"13.5\" y=\"4.5\" width=\"7\" height=\"7\" rx=\"1.5\"></rect><rect x=\"3.5\" y=\"14.5\" width=\"7\" height=\"7\" rx=\"1.5\"></rect><rect x=\"13.5\" y=\"14.5\" width=\"7\" height=\"7\" rx=\"1.5\"></rect></svg>"
          }
        },
        "tab_play": {
          "type": "tab",
          "settings": {
            "label": "Play",
            "url": "/pages/how-to-play",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"13.5\" r=\"7.5\"></circle><path d=\"M12 9.5v4l2.5 1.5\"></path><path d=\"M9 2.5h6\"></path><path d=\"M12 2.5V6\"></path></svg>"
          }
        },
        "tab_cart": {
          "type": "tab",
          "settings": {
            "label": "Cart",
            "url": "/cart",
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 7.5h14l-1.2 13H6.2Z\"></path><path d=\"M8.75 9.5V6a3.25 3.25 0 0 1 6.5 0v3.5\"></path></svg>",
            "show_cart_count": true
          }
        }
      },
      "block_order": ["tab_home", "tab_shop", "tab_play", "tab_cart"],
      "settings": {
        "background_color": "#FFF6E9",
        "border_color": "#E7DCCC",
        "active_color": "#E8402A",
        "inactive_color": "#8A7C73"
