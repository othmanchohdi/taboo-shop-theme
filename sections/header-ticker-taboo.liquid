{% liquid
  assign bg = section.settings.background_color | default: '#FCF022'
  assign ink = section.settings.text_color | default: '#14100F'
  assign speed = section.settings.speed | default: 26
%}

<div
  class="taboo-ticker-{{ section.id }}"
  role="marquee"
  aria-label="{{ section.settings.aria_label | default: 'Store highlights' }}"
>
  <div class="taboo-ticker-{{ section.id }}__track">
    {% for i in (1..2) %}
      <div class="taboo-ticker-{{ section.id }}__set" aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
        {% for block in section.blocks %}
          <span class="taboo-ticker-{{ section.id }}__item" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </span>
          {% unless forloop.last %}
            <span class="taboo-ticker-{{ section.id }}__dot" aria-hidden="true">★</span>
          {% endunless %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .taboo-ticker-{{ section.id }} {
    background: {{ bg }};
    color: {{ ink }};
    overflow: hidden;
    white-space: nowrap;
    /* Mobile: design spec 6px 0, desktop: 8px 0 */
    padding: 6px 0;
  }

  .taboo-ticker-{{ section.id }}__track {
    display: inline-flex;
    animation: taboo-ticker-scroll-{{ section.id }} {{ speed }}s linear infinite;
    will-change: transform;
  }

  .taboo-ticker-{{ section.id }}__set {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .taboo-ticker-{{ section.id }}__item {
    /* Mobile: 13px padding, 10.5px font, .16em tracking */
    padding: 0 13px;
    font: 700 10.5px 'DM Sans', system-ui, sans-serif;
    letter-spacing: .16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .taboo-ticker-{{ section.id }}__dot {
    font-size: 10.5px;
    opacity: .8;
  }

  @media screen and (min-width: 1024px) {
    .taboo-ticker-{{ section.id }} { padding: 8px 0; }
    .taboo-ticker-{{ section.id }}__item {
      padding: 0 22px;
      font-size: 11px;
      letter-spacing: .18em;
    }
    .taboo-ticker-{{ section.id }}__dot { font-size: 11px; }
  }

  @keyframes taboo-ticker-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .taboo-ticker-{{ section.id }}__track { animation: none; }
  }
</style>

{% schema %}
{
  "name": "Taboo ticker",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FCF022"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#14100F"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds, lower = faster)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 26
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Store highlights"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "300 cards per pack"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
