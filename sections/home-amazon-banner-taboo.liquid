{%- doc -%}
  Amazon pass-through banner for the base board game (sold via Amazon, not direct).
  Mobile: stacked card. Desktop: 3-col grid inside a bordered frame.
{%- enddoc -%}

{% liquid
  assign image = section.settings.image
  assign eyebrow = section.settings.eyebrow | default: "Don't own the game?"
  assign title = section.settings.title | default: 'Taboo Board Game with Buzzer!'
  assign body = section.settings.body
  assign cta_label = section.settings.cta_label | default: 'Buy on Amazon'
  assign amazon_url = section.settings.amazon_url
%}

<section class="taboo-amazon-{{ section.id }}">
  <div class="taboo-amazon-{{ section.id }}__frame">
    <div class="taboo-amazon-{{ section.id }}__media">
      {% if image %}
        <img src="{{ image | image_url: width: 800 }}" alt="{{ image.alt | default: title }}" loading="lazy" width="800" height="{{ image.height }}">
      {% endif %}
    </div>
    <div class="taboo-amazon-{{ section.id }}__body">
      <span class="taboo-amazon-{{ section.id }}__eyebrow">{{ eyebrow }}</span>
      <div class="taboo-amazon-{{ section.id }}__title">{{ title }}</div>
      {% if body != blank %}
        <p class="taboo-amazon-{{ section.id }}__copy">{{ body }}</p>
      {% endif %}
    </div>
    {% if amazon_url %}
      <a href="{{ amazon_url }}" target="_blank" rel="noopener" class="taboo-amazon-{{ section.id }}__cta">
        {{ cta_label }}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5h11v11"></path><path d="M19 5 6 18"></path></svg>
      </a>
    {% endif %}
  </div>
</section>

<style>
  .taboo-amazon-{{ section.id }} {
    font-family: 'DM Sans', system-ui, sans-serif;
    color: #14100F;
  }

  .taboo-amazon-{{ section.id }}__frame {
    border: 2px solid #14100F;
    border-radius: 20px;
    overflow: hidden;
  }

  .taboo-amazon-{{ section.id }}__media img { display: block; width: 100%; object-fit: contain; background: #FFFFFF; }
  .taboo-amazon-{{ section.id }}__body { background: #EFE4D4; }
  .taboo-amazon-{{ section.id }}__eyebrow {
    display: inline-block; background: #14100F; color: #FFF6E9; border-radius: 999px;
    padding: 4px 9px; font: 700 9.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase;
  }
  .taboo-amazon-{{ section.id }}__title {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.035em;
  }
  .taboo-amazon-{{ section.id }}__copy { margin: 0; color: #5A4F49; line-height: 1.5; }
  .taboo-amazon-{{ section.id }}__cta {
    background: #F2B233; text-decoration: none; color: #14100F; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    font: 700 14.5px 'DM Sans', system-ui, sans-serif;
  }

  @media screen and (max-width: 1023px) {
    .taboo-amazon-{{ section.id }} { padding: 26px 18px; }
    /*
      Mobile: image (86px) and body text are side-by-side in one row, CTA button below full-width.
      The design wraps them in a single flex row with #EFE4D4 background. We achieve this
      using a CSS grid on __frame: 86px for the image column, 1fr for the body, CTA spans both.
    */
    .taboo-amazon-{{ section.id }}__frame {
      display: grid;
      grid-template-columns: 86px 1fr;
      grid-template-rows: auto auto;
      background: #EFE4D4;
    }
    .taboo-amazon-{{ section.id }}__media {
      grid-row: 1;
      grid-column: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px 8px 16px 16px;
    }
    .taboo-amazon-{{ section.id }}__media img {
      width: 70px; height: 70px; border-radius: 12px; background: #FFFFFF; object-fit: contain;
    }
    .taboo-amazon-{{ section.id }}__body {
      grid-row: 1;
      grid-column: 2;
      background: none;
      padding: 16px 16px 16px 6px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .taboo-amazon-{{ section.id }}__eyebrow { margin-bottom: 7px; }
    .taboo-amazon-{{ section.id }}__title { font-size: 20px; line-height: 1; margin-bottom: 4px; }
    .taboo-amazon-{{ section.id }}__copy { font-size: 12.5px; }
    .taboo-amazon-{{ section.id }}__cta {
      grid-row: 2;
      grid-column: 1 / -1;
      border-top: 2px solid #14100F;
      padding: 15px;
    }
  }

  @media screen and (min-width: 1024px) {
    .taboo-amazon-{{ section.id }} { max-width: 1200px; margin: 0 auto; padding: 48px 24px 0; }
    .taboo-amazon-{{ section.id }}__frame {
      /* Desktop: 3-col grid, 24px radius */
      display: grid; grid-template-columns: 230px 1fr auto; align-items: center;
      background: #EFE4D4; border-radius: 24px;
    }
    .taboo-amazon-{{ section.id }}__media { padding: 0; }
    .taboo-amazon-{{ section.id }}__media img { width: 100%; height: 190px; border-radius: 0; }
    .taboo-amazon-{{ section.id }}__body { padding: 26px 30px; }
    .taboo-amazon-{{ section.id }}__eyebrow { padding: 5px 11px; font-size: 10px; letter-spacing: .14em; margin-bottom: 10px; }
    .taboo-amazon-{{ section.id }}__title { font-size: 30px; line-height: 1; margin-bottom: 8px; }
    .taboo-amazon-{{ section.id }}__copy { font-size: 15.5px; max-width: 620px; }
    .taboo-amazon-{{ section.id }}__cta { align-self: stretch; border-left: 2px solid #14100F; padding: 0 34px; font-size: 15.5px; gap: 10px; }
  }
</style>

{% schema %}
{
  "name": "Amazon banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Board game image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Don't own the game?" },
    { "type": "text", "id": "title", "label": "Title", "default": "Taboo Board Game with Buzzer!" },
    { "type": "textarea", "id": "body", "label": "Body copy", "default": "450 game cards including food and drink categories, the electronic buzzer and the 1-minute timer. $29.99, exclusive on Amazon — Taboosters stay in your cart here." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy on Amazon" },
    { "type": "url", "id": "amazon_url", "label": "Amazon listing URL" }
  ],
  "presets": [
    { "name": "Amazon banner" }
  ]
}
{% endschema %}
