{%- doc -%}
  Teal "Why everyone loves it" benefits band. Mobile: single column list.
  Desktop: 320px label column + 2-col checklist grid.
{%- enddoc -%}

{% liquid
  assign eyebrow = section.settings.eyebrow | default: 'Why everyone loves it'
  assign heading = section.settings.heading
  assign items = section.blocks | where: 'type', 'item'
%}

<section class="taboo-benefits-{{ section.id }} {{ section.settings.section_width }}">
  <div class="taboo-benefits-{{ section.id }}__inner">
    <div class="taboo-benefits-{{ section.id }}__label">
      <p class="taboo-benefits-{{ section.id }}__eyebrow">{{ eyebrow }}</p>
      {% if heading != blank %}
        <h2 class="taboo-benefits-{{ section.id }}__heading">{{ heading }}</h2>
      {% endif %}
    </div>
    <div class="taboo-benefits-{{ section.id }}__list">
      {% for block in items %}
        <div class="taboo-benefits-{{ section.id }}__item" {{ block.shopify_attributes }}>
          <span class="taboo-benefits-{{ section.id }}__check">✓</span>{{ block.settings.text }}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .taboo-benefits-{{ section.id }} {
    --ben-bg: {{ section.settings.bg_color | default: '#AF6EF7' }};
    --ben-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --ben-eyebrow: {{ section.settings.eyebrow_color | default: '#F2B233' }};
    --ben-heading: {{ section.settings.heading_color | default: '#FFFFFF' }};
    --ben-check-bg: {{ section.settings.check_bg | default: '#F2B233' }};
    --ben-check-text: {{ section.settings.check_text | default: '#14100F' }};
    --ben-border: {{ section.settings.border_color | default: 'rgba(255,255,255,0.25)' }};
    background-color: var(--ben-bg);
    {% if section.settings.bg_image %}
      background-image: url({{ section.settings.bg_image | image_url: width: 1600 }});
      background-size: cover;
      background-position: center;
    {% endif %}
    color: var(--ben-text);
    font-family: 'DM Sans', system-ui, sans-serif;
  }

  .taboo-benefits-{{ section.id }}__eyebrow {
    margin: 0 0 12px;
    font: 700 11px 'DM Sans', system-ui, sans-serif;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ben-eyebrow);
  }

  .taboo-benefits-{{ section.id }}__heading {
    margin: 0;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--ben-heading);
  }

  .taboo-benefits-{{ section.id }}__check {
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--ben-check-bg);
    color: var(--ben-check-text);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 1023px) {
    .taboo-benefits-{{ section.id }} { padding: 26px 18px; }
    .taboo-benefits-{{ section.id }}__eyebrow { margin: 0 0 14px; font-size: 10.5px; letter-spacing: .16em; }
    .taboo-benefits-{{ section.id }}__list { display: flex; flex-direction: column; gap: 11px; }
    .taboo-benefits-{{ section.id }}__item {
      display: flex; gap: 11px; align-items: flex-start; font-size: 15px; line-height: 1.4;
    }
    .taboo-benefits-{{ section.id }}__check { width: 18px; height: 18px; font-size: 11px; margin-top: 2px; }
  }

  @media screen and (min-width: 1024px) {
    .taboo-benefits-{{ section.id }} { margin-top: 64px; }
    .taboo-benefits-{{ section.id }}__inner {
      padding: 56px 24px;
      display: grid; grid-template-columns: 320px 1fr; gap: 56px;
    }
    .taboo-benefits-{{ section.id }}.page-width .taboo-benefits-{{ section.id }}__inner { max-width: 1200px; margin: 0 auto; }
    .taboo-benefits-{{ section.id }}.full-width .taboo-benefits-{{ section.id }}__inner { padding-inline: 40px; }
    .taboo-benefits-{{ section.id }}__heading { font-size: 38px; line-height: 1; }
    .taboo-benefits-{{ section.id }}__list {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px 40px;
    }
    .taboo-benefits-{{ section.id }}__item {
      display: flex; gap: 13px; align-items: flex-start; font-size: 17px; line-height: 1.45;
      padding-top: 16px; border-top: 1.5px solid var(--ben-border);
    }
    .taboo-benefits-{{ section.id }}__check { width: 20px; height: 20px; font-size: 12px; margin-top: 3px; }
  }
</style>

{% schema %}
{
  "name": "Benefits band",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why everyone loves it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Perfect for parties, families and groups" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#AF6EF7" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (overlays color)" },
    { "type": "color", "id": "text_color", "label": "Item text color", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#F2B233" },
    { "type": "color", "id": "check_bg", "label": "Check icon background", "default": "#F2B233" },
    { "type": "color", "id": "check_text", "label": "Check icon color", "default": "#14100F" },
    { "type": "color", "id": "border_color", "label": "Item divider color (desktop)", "default": "#ffffff40" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fits in a coat pocket" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits band",
      "blocks": [
        { "type": "item", "settings": { "text": "Fits in a coat pocket" } },
        { "type": "item", "settings": { "text": "No batteries needed" } },
        { "type": "item", "settings": { "text": "300+ new cards per pack" } },
        { "type": "item", "settings": { "text": "Works with the game you already own" } }
      ]
    }
  ]
}
{% endschema %}
