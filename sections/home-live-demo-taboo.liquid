{%- doc -%}
  "Try a card" live demo (timer, buzzer, card cycling) + Tabooster Packs product grid.
  Mobile: demo stacked above a horizontal-scroll pack carousel (dark band).
  Desktop: packs in a 2x2 grid on the left, demo panel sticky on the right.
  Card data comes from repeatable blocks (not real products - it's illustrative gameplay content).
  Pack products come from a real Shopify collection.
{%- enddoc -%}

{% liquid
  assign collection = section.settings.collection
  assign cards = section.blocks | where: 'type', 'card'
%}

<section class="taboo-demo-{{ section.id }} {{ section.settings.section_width }}">

  <taboo-card-demo class="taboo-demo-{{ section.id }}__panel" data-timer-seconds="60">
    <div class="taboo-demo-{{ section.id }}__panel-inner">
      <div class="taboo-demo-{{ section.id }}__panel-head">
        <h3 class="taboo-demo-{{ section.id }}__panel-title">Try a card</h3>
        <span class="taboo-demo-{{ section.id }}__panel-tag">Live from the packs</span>
      </div>
      <p class="taboo-demo-{{ section.id }}__panel-copy">Get someone to say the top word. Use any of the five below it and the buzzer wins.</p>

      <div class="taboo-demo-{{ section.id }}__card">
        <div class="taboo-demo-{{ section.id }}__card-inner" data-card-inner>
          {% for block in cards %}
            <div
              class="taboo-demo-{{ section.id }}__card-face{% if forloop.first %} is-active{% endif %}"
              data-card-face
              data-pack-url="{{ block.settings.pack_url }}"
              {{ block.shopify_attributes }}
            >
              <button type="button" class="taboo-demo-{{ section.id }}__card-source" data-open-pack data-url="{{ block.settings.pack_url }}">
                <span>{{ block.settings.pack_name }}</span>
                <span class="taboo-demo-{{ section.id }}__card-source-link">Shop it →</span>
              </button>
              <div class="taboo-demo-{{ section.id }}__word-plate">{{ block.settings.word }}</div>
              <div class="taboo-demo-{{ section.id }}__taboo-list">
                {% for i in (1..5) %}
                  {% assign word_key = 'taboo_' | append: i %}
                  {% assign word = block.settings[word_key] %}
                  {% if word != blank %}
                    <div class="taboo-demo-{{ section.id }}__taboo-item">
                      <span class="taboo-demo-{{ section.id }}__taboo-x">×</span>
                      <span>{{ word }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="taboo-demo-{{ section.id }}__footer-bar">
      <div class="taboo-demo-{{ section.id }}__timer">
        <div class="taboo-demo-{{ section.id }}__timer-num" data-timer-display>0:60</div>
        <div class="taboo-demo-{{ section.id }}__timer-label">left</div>
      </div>
      <button type="button" class="taboo-demo-{{ section.id }}__timer-btn" data-timer-toggle>Start</button>
      <button type="button" class="taboo-demo-{{ section.id }}__next-btn" data-next-card>Next</button>
      <button type="button" class="taboo-demo-{{ section.id }}__buzz-btn" data-buzz>BUZZ</button>
    </div>

    <button type="button" class="taboo-demo-{{ section.id }}__deal-btn" data-next-card-mobile>Deal another card</button>

    <div class="taboo-demo-{{ section.id }}__buzz-overlay" data-buzz-overlay aria-hidden="true">BZZT!</div>
  </taboo-card-demo>

  <div class="taboo-demo-{{ section.id }}__packs">
    <div class="taboo-demo-{{ section.id }}__packs-head">
      <h2 class="taboo-demo-{{ section.id }}__packs-title">Tabooster Packs</h2>
      {% if section.settings.shop_all_url %}
        <a href="{{ section.settings.shop_all_url }}" class="taboo-demo-{{ section.id }}__packs-see-all">
          <span class="taboo-demo-{{ section.id }}__packs-see-all--mobile">Shop all</span>
          <span class="taboo-demo-{{ section.id }}__packs-see-all--desktop">See the whole catalog →</span>
        </a>
      {% endif %}
    </div>
    <p class="taboo-demo-{{ section.id }}__packs-sub">300+ all-new cards each. Compact, travel-friendly box. Shuffle them into the game you already own.</p>

    <div class="taboo-demo-{{ section.id }}__packs-grid">
      {% if collection %}
        {% for product in collection.products limit: 4 %}
          <a href="{{ product.url }}" class="taboo-demo-{{ section.id }}__pack-card">
            <div class="taboo-demo-{{ section.id }}__pack-media">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              {% else %}
                <span class="taboo-demo-{{ section.id }}__pack-media-fallback">{{ product.title }}</span>
              {% endif %}
            </div>
            <div class="taboo-demo-{{ section.id }}__pack-body">
              <div class="taboo-demo-{{ section.id }}__pack-name">{{ product.title }}</div>
              <div class="taboo-demo-{{ section.id }}__pack-meta">{{ product.metafields.custom.card_line | default: '300 cards' }}</div>
              <div class="taboo-demo-{{ section.id }}__pack-bottom">
                <span class="taboo-demo-{{ section.id }}__pack-price">{{ product.price | money }}</span>
                <span class="taboo-demo-{{ section.id }}__pack-view">View pack</span>
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <p class="taboo-demo-{{ section.id }}__packs-empty">Select a collection in section settings to show packs here.</p>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'taboo-card-demo.js' | asset_url }}" defer="defer"></script>

<style>
  .taboo-demo-{{ section.id }} {
    font-family: 'DM Sans', system-ui, sans-serif;
    color: #14100F;
  }

  /* ---------- Card demo panel ---------- */
  .taboo-demo-{{ section.id }}__panel {
    display: block;
    background: #FFFFFF;
    border: 2px solid #14100F;
    border-radius: 22px;
    box-shadow: 7px 7px 0 #14100F;
    overflow: hidden;
  }

  .taboo-demo-{{ section.id }}__panel-inner { padding: 18px 18px 16px; }
  .taboo-demo-{{ section.id }}__panel-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
  .taboo-demo-{{ section.id }}__panel-title {
    margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800;
    font-size: 27px; letter-spacing: -.035em;
  }
  .taboo-demo-{{ section.id }}__panel-tag {
    font: 700 10.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .12em;
    text-transform: uppercase; color: #E8402A;
  }
  .taboo-demo-{{ section.id }}__panel-copy { margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #5A4F49; }

  .taboo-demo-{{ section.id }}__card { border-radius: 0; }
  .taboo-demo-{{ section.id }}__card-inner { position: relative; }

  .taboo-demo-{{ section.id }}__card-face {
    display: none;
    padding: 0;
    animation: taboo-deal-in-{{ section.id }} .4s cubic-bezier(.2,.9,.3,1.2) both;
  }
  .taboo-demo-{{ section.id }}__card-face.is-active { display: block; }

  @keyframes taboo-deal-in-{{ section.id }} {
    from { opacity: 0; transform: translateY(20px) rotate(-4deg) scale(.93); }
    to { opacity: 1; transform: none; }
  }

  .taboo-demo-{{ section.id }}__card-source {
    width: 100%; background: none; border: 0; padding: 0; margin-bottom: 12px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font: 700 10px 'DM Sans', system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase;
    color: #8A7C73;
  }
  .taboo-demo-{{ section.id }}__card-source-link { color: #E8402A; }

  .taboo-demo-{{ section.id }}__word-plate {
    background: #14100F; color: #FFF6E9; border-radius: 14px; padding: 16px;
    text-align: center; margin-bottom: 14px;
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 34px;
    letter-spacing: -.025em; text-transform: uppercase;
  }

  .taboo-demo-{{ section.id }}__taboo-list { display: flex; flex-direction: column; gap: 7px; }
  .taboo-demo-{{ section.id }}__taboo-item { display: flex; align-items: center; gap: 10px; }
  .taboo-demo-{{ section.id }}__taboo-x {
    flex: 0 0 auto; width: 16px; height: 16px; border-radius: 50%;
    background: #FDE3DE; color: #E8402A; font: 800 11px 'DM Sans', system-ui, sans-serif;
    display: flex; align-items: center; justify-content: center;
  }
  .taboo-demo-{{ section.id }}__taboo-item span:last-child {
    font: 500 16px 'DM Sans', system-ui, sans-serif; text-transform: uppercase; color: #5A4F49;
    text-decoration: line-through; text-decoration-color: #E8402A; text-decoration-thickness: 2px;
  }

  .taboo-demo-{{ section.id }}__footer-bar {
    background: #14100F; padding: 12px; display: flex; gap: 8px; align-items: center;
  }
  .taboo-demo-{{ section.id }}__timer { flex: 0 0 auto; width: 58px; text-align: center; color: #FFF6E9; }
  .taboo-demo-{{ section.id }}__timer-num {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 23px; letter-spacing: -.02em;
  }
  .taboo-demo-{{ section.id }}__timer-num.is-low { color: #E8402A; }
  .taboo-demo-{{ section.id }}__timer-label { font: 700 8.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; opacity: .5; }
  .taboo-demo-{{ section.id }}__timer-btn {
    flex: 1; background: #FFF6E9; color: #14100F; border: 0; border-radius: 12px; padding: 13px;
    font: 700 14px 'DM Sans', system-ui, sans-serif; cursor: pointer;
  }
  .taboo-demo-{{ section.id }}__next-btn {
    display: none; flex: 0 0 auto; background: rgba(255,246,233,.14); color: #FFF6E9; border: 0;
    border-radius: 12px; padding: 15px 16px; font: 700 14px 'DM Sans', system-ui, sans-serif; cursor: pointer;
  }
  .taboo-demo-{{ section.id }}__buzz-btn {
    flex: 0 0 auto; width: 66px; height: 46px; background: #E8402A; color: #FFF6E9; border: 0;
    border-radius: 12px; font: 800 12px 'DM Sans', system-ui, sans-serif; letter-spacing: .1em; cursor: pointer;
  }
  .taboo-demo-{{ section.id }}__deal-btn {
    display: block; margin: 12px 18px 16px; background: none; border: 1.5px solid #DCCEBB; border-radius: 12px;
    padding: 12px; font: 700 13.5px 'DM Sans', system-ui, sans-serif; color: #14100F; cursor: pointer;
  }

  .taboo-demo-{{ section.id }}__buzz-overlay {
    position: fixed; inset: 0; background: rgba(232,64,42,.94); color: #FFF6E9;
    display: none; align-items: center; justify-content: center; z-index: 999;
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 70px; letter-spacing: -.05em;
    pointer-events: none;
  }
  .taboo-demo-{{ section.id }}__buzz-overlay.is-active {
    display: flex;
    animation: taboo-buzz-shake-{{ section.id }} .4s ease-in-out both;
  }
  @keyframes taboo-buzz-shake-{{ section.id }} {
    0%, 100% { transform: none; }
    20% { transform: translateX(-10px) rotate(-1deg); }
    40% { transform: translateX(10px) rotate(1deg); }
    60% { transform: translateX(-6px); }
    80% { transform: translateX(6px); }
  }
  @media screen and (min-width: 1024px) {
    .taboo-demo-{{ section.id }}__buzz-overlay { font-size: 150px; }
  }

  /* ---------- Packs grid ---------- */
  .taboo-demo-{{ section.id }}__packs-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4px; }
  .taboo-demo-{{ section.id }}__packs-title {
    margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 27px; letter-spacing: -.035em;
  }
  .taboo-demo-{{ section.id }}__packs-see-all { font: 700 13px 'DM Sans', system-ui, sans-serif; color: #F2B233; text-decoration: none; }
  .taboo-demo-{{ section.id }}__packs-see-all--desktop { display: none; }
  .taboo-demo-{{ section.id }}__packs-sub { margin: 0 0 16px; font-size: 14px; color: rgba(255,246,233,.6); }
  .taboo-demo-{{ section.id }}__packs-empty { color: rgba(255,246,233,.6); font-size: 14px; }

  .taboo-demo-{{ section.id }}__pack-card {
    text-align: left; background: #FFF6E9; border-radius: 20px; overflow: hidden; text-decoration: none;
    color: #14100F; display: block;
  }
  .taboo-demo-{{ section.id }}__pack-media {
    aspect-ratio: 5/4; background: #F2B233; display: flex; align-items: center; justify-content: center;
    padding: 10px; position: relative;
  }
  .taboo-demo-{{ section.id }}__pack-media img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  .taboo-demo-{{ section.id }}__pack-media-fallback {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 23px; line-height: .94;
    letter-spacing: -.035em; text-align: center;
  }
  .taboo-demo-{{ section.id }}__pack-body { padding: 13px 14px 15px; }
  .taboo-demo-{{ section.id }}__pack-name { font: 700 15px 'DM Sans', system-ui, sans-serif; margin-bottom: 3px; }
  .taboo-demo-{{ section.id }}__pack-meta { font: 500 11.5px 'DM Sans', system-ui, sans-serif; color: #8A7C73; margin-bottom: 8px; }
  .taboo-demo-{{ section.id }}__pack-bottom { display: flex; align-items: center; justify-content: space-between; }
  .taboo-demo-{{ section.id }}__pack-price { font: 700 16px 'DM Sans', system-ui, sans-serif; color: #E8402A; }
  .taboo-demo-{{ section.id }}__pack-view {
    background: #14100F; color: #FFF6E9; border-radius: 10px; padding: 8px 12px; font: 700 12.5px 'DM Sans', system-ui, sans-serif;
  }

  /* ---------- Mobile layout ---------- */
  @media screen and (max-width: 1023px) {
    .taboo-demo-{{ section.id }} { display: flex; flex-direction: column; }
    .taboo-demo-{{ section.id }}__panel { margin: 30px 18px 26px; border-radius: 22px; }
    .taboo-demo-{{ section.id }}__next-btn { display: none !important; }

    .taboo-demo-{{ section.id }}__packs {
      order: 2;
      background: #14100F; color: #FFF6E9; padding: 28px 0 32px;
    }
    .taboo-demo-{{ section.id }}__packs-head,
    .taboo-demo-{{ section.id }}__packs-sub { padding: 0 18px; }
    .taboo-demo-{{ section.id }}__packs-grid {
      display: flex; gap: 12px; overflow-x: auto; padding: 0 18px 8px; scrollbar-width: none;
    }
    .taboo-demo-{{ section.id }}__pack-card { flex: 0 0 228px; }
  }

  /* ---------- Desktop layout ---------- */
  @media screen and (min-width: 1024px) {
    .taboo-demo-{{ section.id }} {
      padding: 72px 24px 24px;
      display: grid; grid-template-columns: 1fr 420px; gap: 56px; align-items: start;
    }
    .taboo-demo-{{ section.id }}.page-width { max-width: 1200px; margin: 0 auto; }
    .taboo-demo-{{ section.id }}.full-width { padding-inline: 40px; }
    .taboo-demo-{{ section.id }}__panel {
      order: 2; border-radius: 24px; box-shadow: 10px 10px 0 #14100F;
      position: sticky; top: 110px;
    }
    .taboo-demo-{{ section.id }}__panel-inner { padding: 22px 22px 8px; }
    .taboo-demo-{{ section.id }}__panel-title { font-size: 26px; }
    .taboo-demo-{{ section.id }}__panel-copy { font-size: 14.5px; margin-bottom: 18px; }
    .taboo-demo-{{ section.id }}__card { padding: 0 22px 18px; }
    .taboo-demo-{{ section.id }}__word-plate { padding: 22px; border-radius: 16px; font-size: 40px; }
    /* Desktop taboo list: 9px gap (mobile is 7px) */
    .taboo-demo-{{ section.id }}__taboo-list { gap: 9px; }
    /* Desktop taboo X: 18×18px, 12px font */
    .taboo-demo-{{ section.id }}__taboo-x { width: 18px; height: 18px; font-size: 12px; }
    /* Desktop taboo word: 17px */
    .taboo-demo-{{ section.id }}__taboo-item span:last-child { font-size: 17px; }
    .taboo-demo-{{ section.id }}__timer { width: 64px; }
    .taboo-demo-{{ section.id }}__timer-num { font-size: 26px; }
    /* Desktop timer label: 9px (mobile 8.5px) */
    .taboo-demo-{{ section.id }}__timer-label { font-size: 9px; }
    .taboo-demo-{{ section.id }}__timer-btn { padding: 15px; font-size: 15px; }
    .taboo-demo-{{ section.id }}__next-btn { display: block; }
    .taboo-demo-{{ section.id }}__buzz-btn { width: 78px; height: 50px; font-size: 13px; }
    .taboo-demo-{{ section.id }}__deal-btn { display: none; }
    .taboo-demo-{{ section.id }}__footer-bar { padding: 14px; gap: 10px; }

    .taboo-demo-{{ section.id }}__packs { order: 1; }
    .taboo-demo-{{ section.id }}__packs-title { font-size: 42px; margin-bottom: 8px; }
    /* Desktop packs-sub: 16px, cream color removed (now #5A4F49 on white bg) */
    .taboo-demo-{{ section.id }}__packs-sub { color: #5A4F49; font-size: 16px; margin-bottom: 26px; padding: 0; }
    .taboo-demo-{{ section.id }}__packs-head { padding: 0; margin-bottom: 8px; }
    .taboo-demo-{{ section.id }}__packs-see-all--mobile { display: none; }
    .taboo-demo-{{ section.id }}__packs-see-all--desktop { display: inline; }
    .taboo-demo-{{ section.id }}__packs-see-all { color: #E8402A; font-size: 14.5px; }
    .taboo-demo-{{ section.id }}__packs-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    }
    /* Desktop pack card: white (mobile is cream #FFF6E9, since it sits on the dark band there) */
    .taboo-demo-{{ section.id }}__pack-card { background: #FFFFFF; transition: box-shadow .2s ease; }
    .taboo-demo-{{ section.id }}__pack-card:hover { box-shadow: 0 16px 34px rgba(20,16,15,.14); }
    /* Desktop pack media: 4/3 aspect (mobile is 5/4) */
    .taboo-demo-{{ section.id }}__pack-media { aspect-ratio: 4/3; }
    .taboo-demo-{{ section.id }}__pack-body { padding: 18px 20px 20px; }
    .taboo-demo-{{ section.id }}__pack-name { font-size: 18px; margin-bottom: 4px; }
    .taboo-demo-{{ section.id }}__pack-meta { font-size: 13px; margin-bottom: 12px; }
    .taboo-demo-{{ section.id }}__pack-price { font-size: 19px; }
    .taboo-demo-{{ section.id }}__pack-view { border-radius: 11px; padding: 10px 16px; font-size: 13.5px; }
  }
</style>

{% schema %}
{
  "name": "Try a card + Packs",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "collection", "id": "collection", "label": "Tabooster Packs collection" },
    { "type": "url", "id": "shop_all_url", "label": "\"Shop all / See catalog\" link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Demo card",
      "settings": [
        { "type": "text", "id": "pack_name", "label": "Pack name (shown as source label)", "default": "Pop Culture" },
        { "type": "url", "id": "pack_url", "label": "\"Shop it\" link" },
        { "type": "text", "id": "word", "label": "Word to guess", "default": "BIRTHDAY" },
        { "type": "text", "id": "taboo_1", "label": "Taboo word 1", "default": "CAKE" },
        { "type": "text", "id": "taboo_2", "label": "Taboo word 2", "default": "PARTY" },
        { "type": "text", "id": "taboo_3", "label": "Taboo word 3", "default": "CANDLES" },
        { "type": "text", "id": "taboo_4", "label": "Taboo word 4", "default": "PRESENT" },
        { "type": "text", "id": "taboo_5", "label": "Taboo word 5", "default": "OLD" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Try a card + Packs",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
