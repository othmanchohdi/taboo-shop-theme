{%- doc -%}
  "Never played?" rules teaser. Mobile: stacked list + full-width CTA.
  Desktop: 2-col (rules list + CTA on the left, card photo on the right).
{%- enddoc -%}

{% liquid
  assign heading = section.settings.heading | default: 'Never played?'
  assign subheading = section.settings.subheading | default: "Three lines and you're ready."
  assign image = section.settings.image
  assign cta_label = section.settings.cta_label | default: 'Read the full rules'
  assign cta_url = section.settings.cta_url
  assign steps = section.blocks | where: 'type', 'step'
%}

<section class="taboo-rules-{{ section.id }} {{ section.settings.section_width }}">
  <div class="taboo-rules-{{ section.id }}__inner">
    <div class="taboo-rules-{{ section.id }}__col">
      <h2 class="taboo-rules-{{ section.id }}__heading">{{ heading }}</h2>
      <p class="taboo-rules-{{ section.id }}__sub">{{ subheading }}</p>
      <div class="taboo-rules-{{ section.id }}__list">
        {% for block in steps %}
          <div class="taboo-rules-{{ section.id }}__step" {{ block.shopify_attributes }}>
            <span class="taboo-rules-{{ section.id }}__num">{{ forloop.index }}</span>
            <span class="taboo-rules-{{ section.id }}__text">{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
      {% if cta_url %}
        <a href="{{ cta_url }}" class="taboo-rules-{{ section.id }}__cta">{{ cta_label }}</a>
      {% endif %}
    </div>
    <div class="taboo-rules-{{ section.id }}__media">
      {% if image %}
        <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: heading }}" loading="lazy" width="1200" height="{{ image.height }}">
      {% endif %}
    </div>
  </div>
</section>

<style>
  .taboo-rules-{{ section.id }} {
    --rules-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --rules-heading: {{ section.settings.heading_color | default: '#14100F' }};
    --rules-text: {{ section.settings.text_color | default: '#5A4F49' }};
    --rules-accent: {{ section.settings.accent_color | default: '#AF6EF7' }};
    --rules-btn-bg: {{ section.settings.btn_bg | default: '#402651' }};
    --rules-btn-text: {{ section.settings.btn_text | default: '#FFFFFF' }};
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--rules-heading);
    background: var(--rules-bg);
  }

  .taboo-rules-{{ section.id }}__heading {
    margin: 0 0 8px;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    letter-spacing: -.04em;
    color: var(--rules-heading);
  }

  .taboo-rules-{{ section.id }}__sub { margin: 0 0 16px; color: var(--rules-text); }

  .taboo-rules-{{ section.id }}__step {
    display: flex; align-items: flex-start; border-top: 1.5px solid #E7DCCC;
  }
  .taboo-rules-{{ section.id }}__num {
    flex: 0 0 auto; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800;
    line-height: 1; letter-spacing: -.04em; color: var(--rules-accent);
  }
  .taboo-rules-{{ section.id }}__text { color: var(--rules-text); }

  .taboo-rules-{{ section.id }}__cta {
    display: inline-block; text-align: center; text-decoration: none; cursor: pointer;
    background: var(--rules-btn-bg); color: var(--rules-btn-text); border: 0; font: 700 15px 'DM Sans', system-ui, sans-serif;
  }

  .taboo-rules-{{ section.id }}__media img {
    width: 100%; display: block; object-fit: cover; background: #402651;
  }

  @media screen and (max-width: 1023px) {
    .taboo-rules-{{ section.id }} { padding: 28px 18px 34px; }
    .taboo-rules-{{ section.id }}__heading { font-size: 27px; margin-bottom: 4px; }
    .taboo-rules-{{ section.id }}__sub { font-size: 14px; }
    .taboo-rules-{{ section.id }}__step { gap: 14px; padding: 15px 0; }
    .taboo-rules-{{ section.id }}__num { font-size: 26px; width: 26px; }
    .taboo-rules-{{ section.id }}__text { font-size: 14.5px; line-height: 1.45; padding-top: 3px; }
    .taboo-rules-{{ section.id }}__cta { width: 100%; margin-top: 18px; border-radius: 15px; padding: 16px; }
    .taboo-rules-{{ section.id }}__media { display: none; }
  }

  @media screen and (min-width: 1024px) {
    .taboo-rules-{{ section.id }}__inner {
      padding: 64px 24px 72px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center;
    }
    .taboo-rules-{{ section.id }}.page-width .taboo-rules-{{ section.id }}__inner { max-width: 1200px; margin: 0 auto; }
    .taboo-rules-{{ section.id }}.full-width .taboo-rules-{{ section.id }}__inner { padding-inline: 40px; }
    .taboo-rules-{{ section.id }}__heading { font-size: 42px; }
    .taboo-rules-{{ section.id }}__sub { font-size: 16px; margin-bottom: 22px; }
    .taboo-rules-{{ section.id }}__step { gap: 18px; padding: 18px 0; }
    .taboo-rules-{{ section.id }}__num { font-size: 32px; width: 32px; }
    .taboo-rules-{{ section.id }}__text { font-size: 16.5px; line-height: 1.45; padding-top: 4px; }
    .taboo-rules-{{ section.id }}__cta { margin-top: 24px; border-radius: 14px; padding: 17px 26px; font-size: 15.5px; }
    .taboo-rules-{{ section.id }}__media img { border-radius: 24px; aspect-ratio: 4/3; }
  }
</style>

{% schema %}
{
  "name": "Never played rules",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never played?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Three lines and you're ready." },
    { "type": "image_picker", "id": "image", "label": "Card photo (desktop only)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read the full rules" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#14100F" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#5A4F49" },
    { "type": "color", "id": "accent_color", "label": "Step number accent color", "default": "#AF6EF7" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#402651" },
    { "type": "color", "id": "btn_text", "label": "Button text color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Rule step",
      "settings": [
        { "type": "text", "id": "text", "label": "Step text", "default": "Deal a card and set the 1-minute timer." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Never played rules",
      "blocks": [
        { "type": "step", "settings": { "text": "Deal a card and set the 1-minute timer." } },
        { "type": "step", "settings": { "text": "Get your team to say the top word without saying the words underneath it." } },
        { "type": "step", "settings": { "text": "Buzz if a taboo word slips out — the other team steals the point." } }
      ]
    }
  ]
}
{% endschema %}
