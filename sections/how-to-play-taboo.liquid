{%- doc -%}
  How to play page. Teal header band, numbered rule steps, and two sticky
  sidebar cards (info panel + Amazon cross-sell) on desktop.
{%- enddoc -%}

{% liquid
  assign steps = section.blocks | where: 'type', 'step'
%}

<section class="taboo-play-{{ section.id }} {{ section.settings.section_width }}">
  <div class="taboo-play-{{ section.id }}__header">
    <div class="taboo-play-{{ section.id }}__header-grid">
      <div class="taboo-play-{{ section.id }}__header-inner">
        <p class="taboo-play-{{ section.id }}__eyebrow">{{ section.settings.eyebrow | default: '4+ players · ages 13+ · 60 seconds' }}</p>
        <h1 class="taboo-play-{{ section.id }}__title">{{ section.settings.heading | default: 'How to play' }}</h1>
        <p class="taboo-play-{{ section.id }}__sub">{{ section.settings.subheading | default: 'Easy to learn in under 60 seconds. Learning it is not the hard part.' }}</p>
      </div>
      {% if section.settings.header_image %}
        <img
          class="taboo-play-{{ section.id }}__header-image"
          src="{{ section.settings.header_image | image_url: width: 1200 }}"
          alt=""
          loading="lazy"
          width="1200"
          height="{{ section.settings.header_image.height }}"
        >
      {% endif %}
    </div>
  </div>

  <div class="taboo-play-{{ section.id }}__body">
    <div class="taboo-play-{{ section.id }}__steps">
      {% for block in steps %}
        <div class="taboo-play-{{ section.id }}__step" {{ block.shopify_attributes }}>
          <span class="taboo-play-{{ section.id }}__step-num">{{ forloop.index }}</span>
          <div>
            <div class="taboo-play-{{ section.id }}__step-heading">{{ block.settings.heading }}</div>
            <div class="taboo-play-{{ section.id }}__step-text">{{ block.settings.text }}</div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="taboo-play-{{ section.id }}__sidebar">
      <div class="taboo-play-{{ section.id }}__panel">
        <p class="taboo-play-{{ section.id }}__panel-label">{{ section.settings.panel_label | default: 'Taboosters need no batteries' }}</p>
        <p class="taboo-play-{{ section.id }}__panel-copy">{{ section.settings.panel_copy | default: 'Every Tabooster is cards-only — no buzzer, no timer, no giant box. Shuffle them into the game you already own and play exactly the same way.' }}</p>
        {% if section.settings.panel_url %}
          <a href="{{ section.settings.panel_url }}" class="taboo-play-{{ section.id }}__panel-btn">{{ section.settings.panel_cta | default: 'Shop the packs' }}</a>
        {% endif %}
      </div>
      {% if section.settings.amazon_url %}
        <div class="taboo-play-{{ section.id }}__amazon">
          <div class="taboo-play-{{ section.id }}__amazon-title">Don't own the box?</div>
          <p class="taboo-play-{{ section.id }}__amazon-copy">450 cards, buzzer and timer — $29.99, exclusive on Amazon.</p>
          <a href="{{ section.settings.amazon_url }}" target="_blank" rel="noopener" class="taboo-play-{{ section.id }}__amazon-btn">Buy on Amazon ↗</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .taboo-play-{{ section.id }} {
    --play-header-bg: {{ section.settings.header_bg | default: '#AF6EF7' }};
    --play-header-text: {{ section.settings.header_text | default: '#FFFFFF' }};
    --play-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --play-text: {{ section.settings.text_color | default: '#14100F' }};
    --play-muted: {{ section.settings.muted_text | default: '#5A4F49' }};
    --play-step-num-bg: {{ section.settings.step_num_bg | default: '#402651' }};
    --play-step-num-text: {{ section.settings.step_num_text | default: '#FFFFFF' }};
    --play-panel-bg: {{ section.settings.panel_bg | default: '#402651' }};
    --play-panel-text: {{ section.settings.panel_text | default: '#FFFFFF' }};
    --play-btn-bg: {{ section.settings.btn_bg | default: '#AF6EF7' }};
    --play-btn-text: {{ section.settings.btn_text | default: '#FFFFFF' }};
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--play-text);
    background: var(--play-bg);
  }

  .taboo-play-{{ section.id }}__header { background: var(--play-header-bg); color: var(--play-header-text); }
  .taboo-play-{{ section.id }}__eyebrow { margin: 0 0 10px; font: 700 10.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .2em; text-transform: uppercase; opacity: .8; }
  .taboo-play-{{ section.id }}__title { margin: 0 0 12px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.045em; }
  .taboo-play-{{ section.id }}__sub { margin: 0; font-size: 15px; opacity: .92; }

  .taboo-play-{{ section.id }}__step { display: flex; align-items: flex-start; border-bottom: 1.5px solid #E7DCCC; }
  .taboo-play-{{ section.id }}__step-num {
    flex: 0 0 auto; border-radius: 10px; background: var(--play-step-num-bg); color: var(--play-step-num-text); font: 800 14px 'DM Sans', system-ui, sans-serif;
    display: flex; align-items: center; justify-content: center;
  }
  .taboo-play-{{ section.id }}__step-heading { font: 700 15.5px 'DM Sans', system-ui, sans-serif; margin-bottom: 4px; color: var(--play-text); }
  .taboo-play-{{ section.id }}__step-text { line-height: 1.5; color: var(--play-muted); }

  .taboo-play-{{ section.id }}__panel { background: var(--play-panel-bg); color: var(--play-panel-text); border-radius: 20px; padding: 18px; }
  .taboo-play-{{ section.id }}__panel-label { margin: 0 0 10px; font: 700 10.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #57CADC; }
  .taboo-play-{{ section.id }}__panel-copy { margin: 0 0 14px; line-height: 1.5; }
  .taboo-play-{{ section.id }}__panel-btn {
    display: inline-block; text-decoration: none; background: var(--play-btn-bg); color: var(--play-btn-text); border-radius: 12px;
    padding: 13px 20px; font: 700 14px 'DM Sans', system-ui, sans-serif; cursor: pointer;
  }
  .taboo-play-{{ section.id }}__amazon { border: 2px solid #402651; border-radius: 18px; padding: 16px; display: flex; gap: 12px; align-items: center; background: #EFE4D4; }
  .taboo-play-{{ section.id }}__amazon-title { font: 700 15px 'DM Sans', system-ui, sans-serif; margin-bottom: 3px; }
  .taboo-play-{{ section.id }}__amazon-copy { margin: 0; font-size: 13px; line-height: 1.45; color: #5A4F49; }
  .taboo-play-{{ section.id }}__amazon-btn {
    flex: 0 0 auto; display: inline-block; text-decoration: none; background: #F2B233; border: 1.5px solid #402651; border-radius: 11px;
    padding: 12px 14px; font: 700 13px 'DM Sans', system-ui, sans-serif; color: #14100F; cursor: pointer;
  }

  @media screen and (max-width: 1023px) {
    .taboo-play-{{ section.id }}__header { padding: 28px 18px; }
    .taboo-play-{{ section.id }}__title { font-size: 42px; }
    .taboo-play-{{ section.id }}__header-image { display: none; }
    .taboo-play-{{ section.id }}__body { padding: 22px 18px 34px; }
    .taboo-play-{{ section.id }}__steps { margin-bottom: 18px; }
    .taboo-play-{{ section.id }}__step { gap: 14px; padding: 16px 0; }
    .taboo-play-{{ section.id }}__step-num { width: 32px; height: 32px; }
    .taboo-play-{{ section.id }}__step-text { font-size: 14px; }
    .taboo-play-{{ section.id }}__sidebar { display: flex; flex-direction: column; gap: 12px; }
    .taboo-play-{{ section.id }}__amazon { flex-direction: row; }
  }

  @media screen and (min-width: 1024px) {
    .taboo-play-{{ section.id }}__header-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; padding: 60px 24px; }
    .taboo-play-{{ section.id }}.page-width .taboo-play-{{ section.id }}__header-grid { max-width: 1200px; margin: 0 auto; }
    .taboo-play-{{ section.id }}.full-width .taboo-play-{{ section.id }}__header-grid { padding-inline: 40px; }
    .taboo-play-{{ section.id }}__eyebrow { margin-bottom: 14px; font-size: 11.5px; opacity: .82; }
    .taboo-play-{{ section.id }}__title { margin-bottom: 16px; font-size: 68px; line-height: .94; letter-spacing: -.05em; }
    .taboo-play-{{ section.id }}__sub { font-size: 18px; line-height: 1.55; max-width: 460px; }
    .taboo-play-{{ section.id }}__header-image { width: 100%; display: block; border-radius: 24px; aspect-ratio: 16/10; object-fit: cover; background: #402651; }
    .taboo-play-{{ section.id }}__body { padding: 52px 24px 80px; display: grid; grid-template-columns: 1fr 380px; gap: 56px; align-items: start; }
    .taboo-play-{{ section.id }}.page-width .taboo-play-{{ section.id }}__body { max-width: 1200px; margin: 0 auto; }
    .taboo-play-{{ section.id }}.full-width .taboo-play-{{ section.id }}__body { padding-inline: 40px; }
    .taboo-play-{{ section.id }}__step { gap: 20px; padding: 22px 0; }
    .taboo-play-{{ section.id }}__step-num { width: 42px; height: 42px; font-size: 17px; border-radius: 12px; }
    .taboo-play-{{ section.id }}__step-heading { margin-bottom: 5px; font-size: 19px; }
    .taboo-play-{{ section.id }}__step-text { font-size: 16px; max-width: 640px; }
    .taboo-play-{{ section.id }}__sidebar { position: sticky; top: 110px; display: flex; flex-direction: column; gap: 18px; }
    .taboo-play-{{ section.id }}__panel { border-radius: 22px; padding: 24px; }
    .taboo-play-{{ section.id }}__panel-label { margin-bottom: 12px; font-size: 11px; }
    .taboo-play-{{ section.id }}__panel-copy { font-size: 16px; margin-bottom: 18px; }
    .taboo-play-{{ section.id }}__panel-btn { border-radius: 13px; padding: 15px 22px; font-size: 15px; }
    .taboo-play-{{ section.id }}__amazon { border-radius: 20px; flex-direction: column; align-items: stretch; padding: 22px; }
    .taboo-play-{{ section.id }}__amazon-title { font-size: 16px; margin-bottom: 6px; }
    .taboo-play-{{ section.id }}__amazon-copy { font-size: 14.5px; line-height: 1.5; margin-bottom: 14px; }
    .taboo-play-{{ section.id }}__amazon-btn { flex: unset; text-align: center; padding: 14px; border-radius: 12px; font-size: 14.5px; width: 100%; box-sizing: border-box; }
  }
</style>

{% schema %}
{
  "name": "How to play",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "4+ players · ages 13+ · 60 seconds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to play" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Easy to learn in under 60 seconds. Learning it is not the hard part." },
    { "type": "image_picker", "id": "header_image", "label": "Header image (desktop only)" },
    { "type": "text", "id": "panel_label", "label": "Info panel label", "default": "Taboosters need no batteries" },
    { "type": "textarea", "id": "panel_copy", "label": "Info panel copy", "default": "Every Tabooster is cards-only — no buzzer, no timer, no giant box. Shuffle them into the game you already own and play exactly the same way." },
    { "type": "text", "id": "panel_cta", "label": "Info panel button label", "default": "Shop the packs" },
    { "type": "url", "id": "panel_url", "label": "Info panel button link" },
    { "type": "url", "id": "amazon_url", "label": "Amazon listing URL (leave blank to hide the card)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "header_bg", "label": "Header band background", "default": "#AF6EF7" },
    { "type": "color", "id": "header_text", "label": "Header band text", "default": "#FFFFFF" },
    { "type": "color", "id": "bg_color", "label": "Body background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#14100F" },
    { "type": "color", "id": "muted_text", "label": "Muted text color", "default": "#5A4F49" },
    { "type": "color", "id": "step_num_bg", "label": "Step number background", "default": "#402651" },
    { "type": "color", "id": "step_num_text", "label": "Step number text", "default": "#FFFFFF" },
    { "type": "color", "id": "panel_bg", "label": "Info panel background", "default": "#402651" },
    { "type": "color", "id": "panel_text", "label": "Info panel text", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_bg", "label": "Panel button background", "default": "#AF6EF7" },
    { "type": "color", "id": "btn_text", "label": "Panel button text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Rule step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Step heading", "default": "Split into teams" },
        { "type": "textarea", "id": "text", "label": "Step text", "default": "Get four or more players and split into two teams." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How to play",
      "blocks": [
        { "type": "step", "settings": { "heading": "Split into teams", "text": "Get four or more players and split into two teams." } },
        { "type": "step", "settings": { "heading": "Deal a card", "text": "One player from the active team draws a card and sets the 1-minute timer." } },
        { "type": "step", "settings": { "heading": "Get your team to guess", "text": "Describe the top word without saying any of the five taboo words underneath it." } },
        { "type": "step", "settings": { "heading": "Buzz on a slip-up", "text": "If a taboo word is said, anyone can buzz — the other team scores instead." } },
        { "type": "step", "settings": { "heading": "Swap and keep score", "text": "Switch teams each round and keep going until the cards run out." } }
      ]
    }
  ]
}
{% endschema %}
