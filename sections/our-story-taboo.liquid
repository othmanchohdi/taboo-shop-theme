{%- doc -%}
  Our story page. Editorial 2-col intro, a stat-card grid, and a red closing CTA band.
{%- enddoc -%}

{% liquid
  assign stats = section.blocks | where: 'type', 'stat'
%}

<section class="taboo-about-{{ section.id }}">
  <div class="taboo-about-{{ section.id }}__intro">
    <div class="taboo-about-{{ section.id }}__intro-copy">
      <p class="taboo-about-{{ section.id }}__eyebrow">{{ section.settings.eyebrow | default: 'The Taboo Shop' }}</p>
      <h1 class="taboo-about-{{ section.id }}__heading">{{ section.settings.heading | default: 'We make the words' }}</h1>
      <p class="taboo-about-{{ section.id }}__body">{{ section.settings.body }}</p>
    </div>
    {% if section.settings.image %}
      <img
        class="taboo-about-{{ section.id }}__image"
        src="{{ section.settings.image | image_url: width: 1200 }}"
        alt=""
        loading="lazy"
        width="1200"
        height="{{ section.settings.image.height }}"
      >
    {% endif %}
  </div>

  {% if stats.size > 0 %}
    <div class="taboo-about-{{ section.id }}__stats">
      {% for block in stats %}
        <div class="taboo-about-{{ section.id }}__stat" {{ block.shopify_attributes }}>
          <div class="taboo-about-{{ section.id }}__stat-value">{{ block.settings.value }}</div>
          <div class="taboo-about-{{ section.id }}__stat-label">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.cta_url %}
    <div class="taboo-about-{{ section.id }}__cta">
      <div class="taboo-about-{{ section.id }}__cta-inner">
        <div class="taboo-about-{{ section.id }}__cta-copy">
          <h2 class="taboo-about-{{ section.id }}__cta-heading">{{ section.settings.cta_heading | default: 'Refill the box' }}</h2>
          <p class="taboo-about-{{ section.id }}__cta-sub">{{ section.settings.cta_subheading | default: 'Pop Culture, 90s, Family — or the Party Pack with all three.' }}</p>
        </div>
        <a href="{{ section.settings.cta_url }}" class="taboo-about-{{ section.id }}__cta-btn">{{ section.settings.cta_label | default: 'Shop the catalog' }}</a>
      </div>
    </div>
  {% endif %}
</section>

<style>
  .taboo-about-{{ section.id }} { font-family: 'DM Sans', system-ui, sans-serif; color: #14100F; }

  .taboo-about-{{ section.id }}__eyebrow { margin: 0 0 14px; font: 700 10.5px 'DM Sans', system-ui, sans-serif; letter-spacing: .2em; text-transform: uppercase; color: #E8402A; }
  .taboo-about-{{ section.id }}__heading { margin: 0 0 16px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.045em; }
  .taboo-about-{{ section.id }}__body { margin: 0; line-height: 1.6; color: #5A4F49; }
  .taboo-about-{{ section.id }}__image { width: 100%; display: block; object-fit: cover; background: #14100F; }

  .taboo-about-{{ section.id }}__stat { background: #FFFFFF; border-radius: 16px; }
  .taboo-about-{{ section.id }}__stat-value { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.04em; color: #E8402A; }
  .taboo-about-{{ section.id }}__stat-label { line-height: 1.4; color: #5A4F49; }

  .taboo-about-{{ section.id }}__cta { background: #E8402A; color: #FFF6E9; }
  .taboo-about-{{ section.id }}__cta-heading { margin: 0 0 10px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.04em; }
  .taboo-about-{{ section.id }}__cta-sub { margin: 0; opacity: .92; }
  .taboo-about-{{ section.id }}__cta-btn {
    flex: 0 0 auto; display: inline-block; text-decoration: none; background: #14100F; color: #FFF6E9;
    border-radius: 14px; font: 700 16px 'DM Sans', system-ui, sans-serif; cursor: pointer;
  }

  @media screen and (max-width: 1023px) {
    .taboo-about-{{ section.id }}__intro { padding: 28px 18px 8px; }
    .taboo-about-{{ section.id }}__heading { font-size: 42px; line-height: .94; }
    .taboo-about-{{ section.id }}__body { font-size: 15px; margin-bottom: 16px; }
    .taboo-about-{{ section.id }}__image { margin: 0 18px 20px; width: calc(100% - 36px); border-radius: 20px; aspect-ratio: 16/10; }
    .taboo-about-{{ section.id }}__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 18px 26px; }
    .taboo-about-{{ section.id }}__stat { padding: 16px; }
    .taboo-about-{{ section.id }}__stat-value { font-size: 28px; letter-spacing: -.035em; }
    .taboo-about-{{ section.id }}__stat-label { font-size: 12.5px; margin-top: 3px; }
    .taboo-about-{{ section.id }}__cta-inner { padding: 28px 18px 34px; }
    .taboo-about-{{ section.id }}__cta-heading { font-size: 27px; }
    .taboo-about-{{ section.id }}__cta-sub { margin-bottom: 16px; }
    .taboo-about-{{ section.id }}__cta-btn { width: 100%; text-align: center; padding: 15px 24px; }
  }

  @media screen and (min-width: 1024px) {
    .taboo-about-{{ section.id }}__intro {
      max-width: 1200px; margin: 0 auto; padding: 60px 24px 40px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center;
    }
    .taboo-about-{{ section.id }}__eyebrow { font-size: 11.5px; }
    .taboo-about-{{ section.id }}__heading { font-size: 68px; line-height: .92; letter-spacing: -.05em; }
    .taboo-about-{{ section.id }}__body { font-size: 17.5px; }
    .taboo-about-{{ section.id }}__image { border-radius: 24px; aspect-ratio: 4/3; }
    .taboo-about-{{ section.id }}__stats {
      max-width: 1200px; margin: 0 auto; padding: 0 24px 60px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
    }
    .taboo-about-{{ section.id }}__stat { border-radius: 20px; padding: 24px; }
    .taboo-about-{{ section.id }}__stat-value { font-size: 42px; letter-spacing: -.04em; }
    .taboo-about-{{ section.id }}__stat-label { font-size: 14.5px; margin-top: 6px; }
    .taboo-about-{{ section.id }}__cta-inner {
      max-width: 1200px; margin: 0 auto; padding: 56px 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 40px;
    }
    .taboo-about-{{ section.id }}__cta-heading { font-size: 40px; }
    .taboo-about-{{ section.id }}__cta-sub { font-size: 17px; }
    .taboo-about-{{ section.id }}__cta-btn { padding: 18px 28px; }
  }
</style>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Taboo Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We make the words" },
    { "type": "textarea", "id": "body", "label": "Body copy", "default": "For over 35 years the box hasn't needed changing — the cards are another story. Once your table has heard them all, the game gets quiet. So we write Taboosters: cards-only expansion packs, 300 all-new cards at a time, in three flavors so far. No buzzer. No timer. No giant box." },
    { "type": "image_picker", "id": "image", "label": "Editorial image" },
    { "type": "text", "id": "cta_heading", "label": "Closing CTA heading", "default": "Refill the box" },
    { "type": "textarea", "id": "cta_subheading", "label": "Closing CTA subheading", "default": "Pop Culture, 90s, Family — or the Party Pack with all three." },
    { "type": "text", "id": "cta_label", "label": "Closing CTA button label", "default": "Shop the catalog" },
    { "type": "url", "id": "cta_url", "label": "Closing CTA button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "300+" },
        { "type": "text", "id": "label", "label": "Label", "default": "New cards per pack" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Our story",
      "blocks": [
        { "type": "stat", "settings": { "value": "300+", "label": "New cards per pack" } },
        { "type": "stat", "settings": { "value": "35", "label": "Years of the original game" } },
        { "type": "stat", "settings": { "value": "3", "label": "Pack flavors so far" } },
        { "type": "stat", "settings": { "value": "60s", "label": "Time to learn it" } }
      ]
    }
  ]
}
{% endschema %}
