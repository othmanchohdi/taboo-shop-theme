{% schema %}
{
  "name": "Product detail",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    { "type": "color", "id": "tint_color", "label": "Product image tint background", "default": "#F2B233" },
    { "type": "url", "id": "back_url", "label": "\"Back to catalog\" link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Page background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Heading & body text", "default": "#14100F" },
    { "type": "color", "id": "muted_text", "label": "Muted / secondary text", "default": "#5A4F49" },
    { "type": "color", "id": "accent_color", "label": "Accent color (prices, dots)", "default": "#AF6EF7" },
    { "type": "color", "id": "btn_bg", "label": "Add-to-cart button background", "default": "#AF6EF7" },
    { "type": "color", "id": "btn_text", "label": "Add-to-cart button text", "default": "#FFFFFF" },
    { "type": "color", "id": "variant_selected_bg", "label": "Selected variant background", "default": "#F0E4FC" },
    { "type": "color", "id": "sample_card_bg", "label": "Sample card background", "default": "#14100F" },
    { "type": "color", "id": "sample_card_text", "label": "Sample card text", "default": "#FFFFFF" },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show full product description",
      "info": "Turn off to hide the product's body copy and rely on the checklist blocks below instead.",
      "default": true
    },
    {
      "type": "header",
      "content": "What you get checklist"
    },
    {
      "type": "paragraph",
      "content": "Add checklist items as blocks below. If no checklist blocks are added, the section falls back to the product's \"what_you_get\" metafield (if set)."
    },
    { "type": "text", "id": "checklist_heading", "label": "Checklist heading", "default": "What you get" },
    { "type": "text", "id": "ships_note", "label": "Shipping / production note", "info": "Overrides the product's \"ships_note\" metafield when set.", "placeholder": "e.g. Made to order by our print partner" }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "300 all new cards" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
