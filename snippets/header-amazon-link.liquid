{% doc %}
  Outlined "Board game on Amazon" link for the header actions row.
  Tablet/desktop only (≥750px) — the mobile header keeps to logo, menu and cart
  per the design handoff.

  @param {string} url
  @param {string} [label]
{% enddoc %}

<a
  href="{{ url }}"
  target="_blank"
  rel="noopener"
  class="header-amazon-link"
>
  {{ label | default: 'Board game on Amazon ↗' }}
</a>

{% stylesheet %}
  .header-amazon-link {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header-amazon-link {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
      border: 1.5px solid rgba(255, 246, 233, .35);
      border-radius: 10px;
      padding: 10px 14px;
      color: #FFF6E9;
      font: 700 13px 'DM Sans', system-ui, sans-serif;
      text-decoration: none;
      white-space: nowrap;
    }

    .header-amazon-link:hover {
      color: #FFF6E9;
      border-color: rgba(255, 246, 233, .6);
    }
  }
{% endstylesheet %}
